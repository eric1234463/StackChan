<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>space.hermes.stackchan-bridge</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BRIDGE_DIR__/.venv/bin/python</string>
    <string>-W</string>
    <string>ignore</string>
    <string>-m</string>
    <string>stackchan_bridge</string>
  </array>
  <key>WorkingDirectory</key><string>__BRIDGE_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__LOG_DIR__/stackchan-bridge.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/stackchan-bridge.log</string>
</dict>
</plist>
