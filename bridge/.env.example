# Copy to .env (gitignored)
BRIDGE_DEVICE_TOKEN=<same as firmware CONFIG_HERMES_WS_TOKEN>
HERMES_API_KEY=<API_SERVER_KEY from ~/.hermes/.env>
# Optional overrides: BRIDGE_PORT STT_URI TTS_URI HERMES_URL HERMES_CONVERSATION VAD_RMS_THRESHOLD VAD_END_SILENCE_MS
# STT_ROMANIZED=1  (only with speech/install.sh STT_ENGINE=qwen3-asr: transcripts are Liujgoj, not Chinese)
# DEVICE_VOLUME=90  (0-100, applied to the StackChan speaker on every connect)
# HERMES_MODEL=muse-spark-1.3-contributor  HERMES_PROVIDER=opencode-go  (voice-turn model; both needed)
# HERMES_SESSION_IDLE_S=900  (new Hermes session after this long without a turn)
# HERMES_REASONING_EFFORT=low  (none|minimal|low|medium|high; profile default is high)
