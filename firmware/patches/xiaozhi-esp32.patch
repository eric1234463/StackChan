+// Hermes: open the channel in the background while idle (and after it drops), so the bridge can
+// push announcements and a wake word skips the ~1 s connect. Retries back off 5 s -> 60 s.
+void Application::MaintainIdleChannel() {
+    // esp_timer, not clock_ticks_: HandleStateChangedEvent resets clock_ticks_ on every state change.
+    if (!protocol_ || GetDeviceState() != kDeviceStateIdle || protocol_->IsAudioChannelOpened() ||
+        esp_timer_get_time() < next_connect_us_) {
+        return;
+    }
+    auto& board = Board::GetInstance();
+    board.SetPowerSaveLevel(PowerSaveLevel::PERFORMANCE);  // handshake must not run in MAX_MODEM
+    background_connecting_ = true;
+    bool opened = protocol_->OpenAudioChannel();
+    background_connecting_ = false;
+    board.SetPowerSaveLevel(PowerSaveLevel::LOW_POWER);
+    connect_backoff_s_ = opened ? 5 : std::min(connect_backoff_s_ * 2, 60);
+    next_connect_us_ = esp_timer_get_time() + int64_t(connect_backoff_s_) * 1000000;
+    ESP_LOGI(TAG, "Background connect %s", opened ? "ok" : "failed");
+}
