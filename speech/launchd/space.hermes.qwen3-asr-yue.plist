<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>space.hermes.qwen3-asr-yue</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SPEECH_DIR__/.venv/bin/python</string>
    <string>-m</string>
    <string>stackchan_speech.stt</string>
    <string>--uri</string>
    <string>tcp://0.0.0.0:10301</string>
    <string>--model</string>
    <string>__QWEN_ASR_MODEL_DIR__</string>
    <string>--engine</string>
    <string>qwen3-asr</string>
  </array>
  <key>WorkingDirectory</key><string>__SPEECH_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__LOG_DIR__/stackchan-stt-qwen.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/stackchan-stt-qwen.log</string>
</dict>
</plist>
