<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>space.hermes.canto-tts</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SPEECH_DIR__/.venv/bin/python</string>
    <string>-m</string>
    <string>stackchan_speech.tts</string>
    <string>--uri</string>
    <string>tcp://0.0.0.0:10201</string>
    <string>--model-dir</string>
    <string>__TTS_MODEL_DIR__</string>
    <string>--voice</string>
    <string>__TTS_VOICE__</string>
    <string>--speed</string>
    <string>__TTS_SPEED__</string>
    <string>--zeroconf</string>
    <string>canto-tts</string>
  </array>
  <key>WorkingDirectory</key><string>__SPEECH_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__LOG_DIR__/stackchan-tts.log</string>
  <key>StandardErrorPath</key><string>__LOG_DIR__/stackchan-tts.log</string>
</dict>
</plist>
